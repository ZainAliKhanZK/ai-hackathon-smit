# =============================================================================
# HCM Lite - .gitignore
# =============================================================================

# --- Environment & Secrets (NEVER commit these) ---
.env
*.env
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
*.manifest
*.spec

# --- Virtual Environment ---
venv/
env/
ENV/
.venv/
.ENV/

# --- Database Files (use migrations in production) ---
*.db
*.sqlite
*.sqlite3

# --- Node.js / Frontend ---
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Testing & Coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# --- IDE & Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/

# --- OS ---
.DS_Store
ehthumbs.db
Desktop.ini

# --- Misc ---
*.bak
*.tmp
*.temp
