# Security & JWT
SECRET_KEY=hcm_lite_jwt_secret_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default: SQLite zero-config)
DATABASE_URL=sqlite:///./hcm_lite.db

# Hosted LLM API Key (Google Gemini API)
AI_API_KEY=your_gemini_api_key_here

# Optional: Pre-populate Admin Account on First Run (if not using Setup UI)
ADMIN_EMAIL=admin@hcmlite.com
ADMIN_PASSWORD=Admin@12345
